{
  "name": "offering-tithe-program",
  "productName": "Offering & Tithe Management Program",
  "version": "1.0.3",
  "description": "Offering and tithe management desktop app (Electron + SQLite)",
  "author": {
    "name": "Nathan Allen",
    "email": "108701336+AndyNate@users.noreply.github.com"
  },
  "main": "main.js",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/AndyNate/offering-tithe-manager.git"
  },
  "scripts": {
    "start": "electron .",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || echo \"electron-rebuild skipped (prebuilt binary may already match)\"",
    "test:db": "electron --no-sandbox test/db.test.js && electron --no-sandbox test/migration.test.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.offeringtithe.manager",
    "files": [
      "main.js",
      "preload.js",
      "db.js",
      "schema.sql",
      "src/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "Offering-Tithe-Program-Setup-${version}.exe",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Offering & Tithe Management Program"
    },
    "portable": {
      "artifactName": "Offering-Tithe-Program-Portable.exe"
    },
    "mac": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.finance",
      "artifactName": "Offering-Tithe-Program-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icon.png",
      "executableName": "offering-tithe-program",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "artifactName": "offering-tithe-program-${version}-${arch}.${ext}"
    }
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "electron@31.7.7": true
  }
}
